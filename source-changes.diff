+export const MAGIC = 'DYNORT01';
+export const MAX_TENDIES_BYTES = 50 * 1024 * 1024;
+const encoder = new TextEncoder();
+const UUID_PATTERN = /^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$/i;
+
+export function validateTendiesFile(file) {
+  if (!file || typeof file.name !== 'string' || !/\.tendies$/i.test(file.name)) {
+    throw new Error('Hãy chọn một tệp có đuôi .tendies.');
+  }
+  if (!Number.isSafeInteger(file.size) || file.size <= 0) {
+    throw new Error('Tệp trống hoặc không đọc được.');
+  }
+  if (file.size > MAX_TENDIES_BYTES) {
+    throw new Error('Tệp vượt quá giới hạn 50 MB.');
+  }
+  const name = file.name;
+  if (name.length < 9 || [...name].length > 255 || name.trim() !== name || /[\u0000-\u001f\u007f/\\]/.test(name)) {
+    throw new Error('Tên tệp không hợp lệ hoặc dài hơn 255 ký tự.');
+  }
+  return true;
+}
+
+export function buildHeader(packageId) {
+  if (typeof packageId !== 'string' || !UUID_PATTERN.test(packageId)) {
+    throw new Error('Mã gói không hợp lệ.');
+  }
+  const header = new Uint8Array(24);
+  header.set(encoder.encode(MAGIC));
+  const hex = packageId.replaceAll('-', '');
+  for (let index = 0; index < 16; index += 1) {
+    header[index + 8] = Number.parseInt(hex.slice(index * 2, index * 2 + 2), 16);
+  }
+  return header;
+}
+
+export function outputFilename(name) {
+  const basename = String(name).split(/[\\/]/).pop().replace(/\.tendies$/i, '');
+  return `${basename || 'wallpaper'}.dynor`;
+}
+
+export function toBase64(bytes) {
+  let binary = '';
+  for (const byte of bytes) binary += String.fromCharCode(byte);
+  return btoa(binary);
+}
+
+export async function encryptTendies(input, options = {}) {
+  const bytes = input instanceof Uint8Array ? input : new Uint8Array(input);
+  if (bytes.byteLength < 4 || bytes.byteLength > MAX_TENDIES_BYTES) {
+    throw new Error(bytes.byteLength > MAX_TENDIES_BYTES ? 'Tệp vượt quá giới hạn 50 MB.' : 'Tệp Tendies không hợp lệ.');
+  }
+  const localHeader = bytes[2] === 0x03 && bytes[3] === 0x04;
+  const emptyZipHeader = bytes[2] === 0x05 && bytes[3] === 0x06;
+  if (bytes[0] !== 0x50 || bytes[1] !== 0x4b || (!localHeader && !emptyZipHeader)) {
+    throw new Error('Tệp không có cấu trúc gói Tendies hợp lệ.');
+  }
+  if (!globalThis.crypto?.subtle) throw new Error('Trình duyệt này chưa hỗ trợ mã hóa an toàn. Hãy dùng Safari hoặc Chrome mới nhất qua HTTPS.');
+  const packageId = (options.packageId ?? crypto.randomUUID()).toLowerCase();
+  const header = buildHeader(packageId);
+  const keyBytes = options.keyBytes ? new Uint8Array(options.keyBytes) : crypto.getRandomValues(new Uint8Array(32));
+  const nonce = options.nonce ? new Uint8Array(options.nonce) : crypto.getRandomValues(new Uint8Array(12));
+  if (keyBytes.byteLength !== 32 || nonce.byteLength !== 12) {
+    keyBytes.fill(0);
+    throw new Error('Thông số mã hóa không hợp lệ.');
+  }
+  try {
+    const key = await crypto.subtle.importKey('raw', keyBytes, { name: 'AES-GCM' }, false, ['encrypt']);
+    const ciphertext = new Uint8Array(await crypto.subtle.encrypt({ name: 'AES-GCM', iv: nonce, additionalData: header, tagLength: 128 }, key, bytes));
