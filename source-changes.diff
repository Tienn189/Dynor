+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createECDH, createDecipheriv, createHash, hkdfSync, randomBytes } from 'node:crypto';
+import { readFile } from 'node:fs/promises';
+import { pathToFileURL } from 'node:url';
+import {
+  packageHeader, packageID, contentHash, originalName, base64, decodeBase64,
+  importKEK, wrapAtRest, unwrapAtRest, recipientPublicKey, wrapForRecipient,
+} from '../_shared/package-crypto.mjs';
+import { createPackageHandler } from '../_shared/package-handlers.mjs';
+
+const ID = '29abc356-4854-4d22-8dbb-a232a411a057';
+const OTHER_ID = '93b9af25-eccc-417d-b04c-a3788aef5382';
+const HASH = 'ab'.repeat(32);
+const USER_ID = '563456bf-d0a8-4b8b-bcb4-529e92db7326';
+const CEK = new Uint8Array(randomBytes(32));
+const KEK = base64(randomBytes(32));
+const ENV = { SUPABASE_URL: 'https://project.invalid', SUPABASE_ANON_KEY: 'test-anon', SUPABASE_SERVICE_ROLE_KEY: 'test-service', DYNOR_PACKAGE_KEK: KEK };
+
+function clientRecipient() {
+  const ec = createECDH('prime256v1');
+  ec.generateKeys();
+  return {
+    public_key: ec.getPublicKey().toString('base64'),
+    unwrap(response, id = ID) {
+      const secret = ec.computeSecret(Buffer.from(response.ephemeral_public_key, 'base64'));
+      const wrapping = hkdfSync('sha256', secret, Buffer.from(response.salt, 'base64'), Buffer.from('DynorContentKey/v1'), 32);
+      const combined = Buffer.from(response.wrapped_key, 'base64');
+      assert.equal(combined.length, 60);
+      const decrypt = createDecipheriv('aes-256-gcm', wrapping, combined.subarray(0, 12));
+      decrypt.setAAD(packageHeader(id));
+      decrypt.setAuthTag(combined.subarray(-16));
+      return Buffer.concat([decrypt.update(combined.subarray(12, -16)), decrypt.final()]);
+    },
+  };
+}
