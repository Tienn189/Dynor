+    } catch (error) {
+      if (error instanceof HTTPFailure) return reply({ error: error.message }, error.status);
+      if (error instanceof PackageInputError) return reply({ error: error.message }, 400);
+      // Do not echo SDK/crypto exceptions: they may contain request data or keys.
+      return reply({ error: 'Package service unavailable' }, 503);
+    } finally { rawKey?.fill(0); }
+  };
+}
