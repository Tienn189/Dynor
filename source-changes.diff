+    encrypted.set(header);
+    encrypted.set(nonce, header.length);
+    encrypted.set(ciphertext, header.length + nonce.length);
+    const digest = new Uint8Array(await crypto.subtle.digest('SHA-256', encrypted));
+    const sha256 = Array.from(digest, byte => byte.toString(16).padStart(2, '0')).join('');
+    return { bytes: encrypted, packageId, sha256, keyBytes };
+  } catch (error) {
+    keyBytes.fill(0);
+    throw error;
+  }
+}
