+  const state = {
+    user: { id: USER_ID }, admin: { user_id: USER_ID },
+    allowed: true, record: null, vip: null, inserts: [], reads: [], rpcCalls: [],
+    ...overrides,
+  };
+  const db = {
+    from(table) {
+      state.reads.push(table);
+      return {
+        select() { return this; }, eq() { return this; },
+        async maybeSingle() {
+          if (state.throwDatabase) throw new Error('internal: SECRET_DO_NOT_RETURN');
+          const key = { dynor_admins: 'admin', dynor_encrypted_packages: 'record', dynor_vip: 'vip' }[table];
+          return { data: state[key], error: state[`${key}Error`] ?? null };
+        },
+        async insert(row) { state.inserts.push(row); return { error: state.insertError ?? null }; },
+      };
+    },
+    async rpc(name, args) { state.rpcCalls.push([name, args]); return { data: state.allowed, error: state.rpcError ?? null }; },
+  };
