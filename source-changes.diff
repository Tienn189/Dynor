+        if (error) throw new HTTPFailure('Could not register package', 503);
+        return reply({ package_id: id, sha256 }, 201);
+      }
+
+      const recipient = await recipientPublicKey(body.public_key);
+      const { data: record, error } = await db.from('dynor_encrypted_packages')
+        .select('package_id,sha256,wrapped_key,requires_vip,active').eq('package_id', id).maybeSingle();
